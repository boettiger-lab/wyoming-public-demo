{
    "sidebar": {
        "enabled": true,
        "chat_title": "Chat"
    },
    "catalog": "https://s3-west.nrp-nautilus.io/public-data/stac/catalog.json",
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "mcp_url": "https://duckdb-mcp.nrp-nautilus.io/mcp",
    "draw_enabled": true,
    "export": true,
    "header": {
        "title": "Public GYE Explorer",
        "partner": {
            "src": "https://cdn.jsdelivr.net/gh/boettiger-lab/wyoming-public-demo@9e977f5e076a41209a8fa6cbdbb56df4e64cad2b/assets/beyond-yellowstone-living-lab-white.png",
            "alt": "Beyond Yellowstone Living Lab",
            "href": "https://www.beyondyellowstone.org/"
        }
    },
    "theme": {
        "mode": "dark",
        "surface": "#0f2213",
        "text": "#f2f6f7",
        "primary": "#2c7a38",
        "backdrop": "#0a170d"
    },
    "view": {
        "center": [-107.5, 43.0],
        "zoom": 7
    },
    "_llm_note": "Uncomment the llm block below for GitHub Pages / static hosting (no server secrets). For Kubernetes, delete it — the k8s/ manifests inject config.json with API keys at deploy time.",
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            { "value": "qwen/qwen3-235b-a22b", "label": "Qwen3 235B" },
            { "value": "moonshotai/kimi-k2", "label": "Kimi K2" },
            { "value": "minimax/minimax-m1", "label": "MiniMax M1" },
            { "value": "anthropic/claude-sonnet-5", "label": "Claude Sonnet 5" },
            { "value": "google/gemini-2.5-flash", "label": "Gemini Flash" }
        ]
    },
    "welcome": {
        "message": "Explore Wyoming wildlife habitat and public lands. Ask me to show layers, filter by species or agency, or run quick calculations.",
        "examples": [
            "Show sage-grouse core areas and sagebrush cover",
            "Show only National Forest and BLM lands, color them green and gold",
            "Show sagebrush cover and invasive annual grass layers",
            "Show sage-grouse core areas and filter protected areas to GAP status 1 and 2",
            "How many acres of crucial elk winter range are there in Wyoming?",
            "Which counties have the most pronghorn habitat?"
        ]
    },
    "collections": [
